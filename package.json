{
  "name": "godot-project-management",
  "version": "1.0.0",
  "description": "下载并管理Godot版本,可隔离不同Godot版本项目,快捷打开Godot项目",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "test": "npm run test:theme && npm run test:preload && npm run test:preload:sandbox && npm run test:composable",
    "test:theme": "node src/__tests__/theme.test.mjs",
    "test:preload": "node src-ztools/preload/lib/__tests__/backup.test.js",
    "test:preload:sandbox": "node src-ztools/preload/lib/__tests__/backup.test.js --no-immediate",
    "test:composable": "node src/composables/__tests__/build-bundle.mjs && node src/composables/__tests__/useBackups.test.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@ztools-center/ztools-api-types": "^1.0.1",
    "typescript": "^5.3.0",
    "vite": "^6.0.11",
    "vue-tsc": "^2.0.0"
  }
}
