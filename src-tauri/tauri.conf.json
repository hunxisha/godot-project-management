{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Godot Workshop",
  "version": "1.0.1",
  "identifier": "com.ztools.godot-workshop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src-ztools/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Godot 工坊",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "publisher": "hunxisha",
    "homepage": "https://github.com/hunxisha/godot-project-management",
    "longDescription": "下载并管理 Godot 引擎版本与导出模板、隔离并快捷打开项目、浏览官方资产市场并安装插件与素材、一键 headless 导出游戏、为项目做完整备份。",
    "shortDescription": "Godot 版本与项目管理工坊",
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
